# API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：其他模型 API Key（预留）
# GEMINI_API_KEY=your_gemini_key
# CLAUDE_API_KEY=your_claude_key

# 多模型配置（为空时自动回退到旧的 VISION_MODEL / LLM_MODEL）
# SUMMARY_MODEL=deepseek
# CHAT_MODEL=deepseek
# VISION_MODEL=deepseek
# SUMMARY_API_KEY=$DEEPSEEK_API_KEY
# CHAT_API_KEY=$DEEPSEEK_API_KEY
# VISION_API_KEY=$DEEPSEEK_API_KEY

# 模型配置（旧配置，保持向后兼容）
VISION_MODEL=deepseek
LLM_MODEL=deepseek

# 本地 VLM 预留配置
LOCAL_VLM_MODEL_PATH=
LOCAL_VLM_DEVICE=cpu

# 处理配置
FRAME_INTERVAL=20
MAX_FRAMES_PER_COURSE=120
FRAME_EXTRACTION_MODE=scene
SCENE_CHANGE_THRESHOLD=0.65
MIN_SCENE_INTERVAL=5.0
OCR_CONFIDENCE_THRESHOLD=0.6
VISION_MAX_WORKERS=4

# RAG 配置
RAG_TOP_K=5
RAG_VECTOR_K=50
RAG_BM25_K=50
RAG_RRF_K=60

# 前端
FRONTEND_ORIGIN=http://localhost:3000

# 视频流
VIDEO_STREAM_CHUNK_SIZE=1048576

# 数据路径
UPLOAD_DIR=./data/uploads
FRAME_DIR=./data/frames
CHROMA_DIR=./data/chroma
BM25_DIR=./data/bm25
DATABASE_URL=sqlite:///./data/app.db

# 日志
LOG_LEVEL=INFO

# 视觉理解开关
ENABLE_VISION=true

# ASR 语音识别（faster-whisper，首次自动下载模型）
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
